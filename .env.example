# Copy to .env and fill in only what the integration gate confirmed.
# Every provider is OFF by default; Nipta then runs on fixtures with a labelled SIMULATED payout.

# Sarvam AI
SARVAM_API_KEY=
# Invoice reading (handwritten / regional-language bills)
SARVAM_VISION_ENABLED=false
SARVAM_EXTRACTION_MODE=doc_ai   # doc_ai = Sarvam Vision OCR extract job (recommended) | chat = sarvam-105b with image input
SARVAM_VISION_MODEL=sarvam-105b # used only when SARVAM_EXTRACTION_MODE=chat
SARVAM_DOC_AI_TIMEOUT_SECONDS=120
SARVAM_DOC_AI_LANGUAGE=         # set (e.g. kn-IN) only if the extract job rejects requests without it
# Agent tool routing
SARVAM_CHAT_ENABLED=false
SARVAM_CHAT_MODEL=sarvam-105b
# Voice questions (speech-to-text) and spoken replies (text-to-speech)
SARVAM_STT_ENABLED=false
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_ENABLED=false
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=             # optional, bulbul:v3 speakers e.g. shubh (default), kavitha, priya

# Cashfree Payouts V2 (sandbox)
CASHFREE_PAYOUTS_ENABLED=false
CASHFREE_BASE_URL=https://sandbox.cashfree.com
CASHFREE_PAYOUTS_CLIENT_ID=
CASHFREE_PAYOUTS_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_2FA_PUBLIC_KEY_PATH=

# Cashfree Secure ID (bank account verification)
CASHFREE_SECUREID_ENABLED=false
CASHFREE_SECUREID_CLIENT_ID=
CASHFREE_SECUREID_CLIENT_SECRET=
CASHFREE_SECUREID_API_VERSION=  # send x-api-version only if the account requires it

# Relay vendor call (docs/relay-vendor-call.md)
RELAY_VENDOR_CALL_URL=          # inbound webhook URL of the Relay agent
RELAY_CALLBACK_SECRET=          # long random string; also saved as a Relay secret property
NIPTA_PUBLIC_URL=               # tunnel URL, e.g. from: cloudflared tunnel --url http://localhost:8000
NIPTA_DEMO_CALL_PHONE=          # demo only: your own phone, so the live call rings you. Never commit it.

# Rules
NIPTA_MIN_FIELD_CONFIDENCE=0.85
NIPTA_ARITH_TOLERANCE_PAISE=0
NIPTA_VERIFICATION_MAX_AGE_DAYS=30
NIPTA_REQUIRE_LIVE_VERIFICATION=true
NIPTA_APPROVAL_TTL_SECONDS=600
NIPTA_AGENT_MAX_TOOL_CALLS=6
NIPTA_TEST_MODE=false           # true enables the labelled TEST_PROVIDER and /api/dev/provider-event

# App
NIPTA_OPERATOR_PIN=2468         # change before any shared demo
NIPTA_SESSION_SECRET=           # long random string; unset = random per process (sessions reset on restart)
NIPTA_DATABASE_PATH=nipta.db
NIPTA_UPLOAD_DIR=uploads
